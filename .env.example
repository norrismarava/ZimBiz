# Database
DATABASE_URL="postgresql://user:password@localhost:5432/zimbiz_connect?schema=public"

# App
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-random-secret-here"

# Optional: SMS provider for phone verification
# SMS_PROVIDER=africastalking
# SMS_API_KEY=
# SMS_SENDER_ID=ZimBiz

# Optional: Email provider
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=

# Optional: File storage (for verification documents)
# STORAGE_PROVIDER=local
# STORAGE_PATH=./uploads
